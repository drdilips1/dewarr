  "components": {
    "schemas": {
      "AuthView": {
        "properties": {
          "user": {
            "$ref": "#/components/schemas/UserView"
          },
          "csrf_token": {
            "type": "string",
            "title": "Csrf Token"
          }
        },
        "type": "object",
        "required": [
          "user",
          "csrf_token"
        ],
        "title": "AuthView"
      },
      "Availability": {
        "properties": {
          "owned": {
            "type": "boolean",
            "title": "Owned",
            "default": false
          },
          "ebook": {
            "type": "boolean",
            "title": "Ebook",
            "default": false
          },
          "audio": {
            "type": "boolean",
            "title": "Audio",
            "default": false
          },
          "stale": {
            "type": "boolean",
            "title": "Stale",
            "default": false
          }
        },
        "type": "object",
        "title": "Availability"
      },
      "BootstrapInput": {
        "properties": {
          "username": {
            "type": "string",
            "maxLength": 100,
            "minLength": 3,
            "pattern": "^[A-Za-z0-9_.@-]+$",
            "title": "Username"
          },
          "password": {
            "type": "string",
            "maxLength": 256,
            "minLength": 12,
            "title": "Password"
          },
          "bootstrap_token": {
            "type": "string",
            "maxLength": 300,
            "minLength": 16,
            "title": "Bootstrap Token"
          },
          "display_name": {
            "type": "string",
            "maxLength": 120,
            "minLength": 1,
            "title": "Display Name"
          }
        },
        "type": "object",
        "required": [
          "username",
          "password",
          "bootstrap_token",
          "display_name"
        ],
        "title": "BootstrapInput"
      },
      "Credentials": {
        "properties": {
          "username": {
            "type": "string",
            "maxLength": 100,
            "minLength": 3,
            "pattern": "^[A-Za-z0-9_.@-]+$",
            "title": "Username"
          },
          "password": {
            "type": "string",
            "maxLength": 256,
            "minLength": 12,
            "title": "Password"
          }
        },
        "type": "object",
        "required": [
          "username",
          "password"
        ],
        "title": "Credentials"
      },
      "EntryInput": {
        "properties": {
          "work_id": {
            "type": "string",
            "format": "uuid",
            "title": "Work Id"
          }
        },
        "type": "object",
        "required": [
          "work_id"
        ],
        "title": "EntryInput"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "ListDetail": {
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1,
            "pattern": "\\S",
            "title": "Name"
          },
          "description": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 3000
              },
              {
                "type": "null"
              }
            ],
            "title": "Description"
          },
          "shared": {
            "type": "boolean",
            "title": "Shared",
            "default": false
          },
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "owner_id": {
            "type": "string",
            "format": "uuid",
            "title": "Owner Id"
          },
          "count": {
            "type": "integer",
            "title": "Count"
          },
          "editable": {
            "type": "boolean",
            "title": "Editable"
          },
          "items": {
            "items": {
              "$ref": "#/components/schemas/WorkView"
            },
            "type": "array",
            "title": "Items"
          }
        },
        "type": "object",
        "required": [
          "name",
          "id",
          "owner_id",
          "count",
          "editable",
          "items"
        ],
        "title": "ListDetail"
      },
      "ListInput": {
        "properties": {
