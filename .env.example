# Generate .env and secrets with: python3 scripts/init_env.py --mode compose
BOOK_DATABASE_URL=postgresql+psycopg://book:replace-me@postgres:5432/book
BOOK_PUBLIC_URL=http://localhost:8000
BOOK_SECRET_KEY_FILE=/run/secrets/app_key
# Set true behind HTTPS and change BOOK_PUBLIC_URL to the exact browser origin.
BOOK_COOKIE_SECURE=false
BOOK_RECOVERY_MODE=false
# Enable after configuring download sources, qBittorrent and verified library routes.
BOOK_DOWNLOAD_DISPATCH_ENABLED=false
BOOK_UID=1000
BOOK_GID=1000

# Container image and published address
DEWARR_IMAGE=ghcr.io/logabell/dewarr:latest
DEWARR_BIND=127.0.0.1
DEWARR_PORT=8000
